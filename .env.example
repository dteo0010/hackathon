# Copy this file to .env and fill in the values.
# .env is git-ignored: never commit a real key.
# On a deployment host such as Render, set these values
# in the service environment settings instead of using a file.

# Gemini / LLM settings
GEMINI_API_KEY=
SDOC_LLM_MODEL=gemini-3.6-flash
SDOC_USE_LLM=1

# Email classifier
# baseline = stable JS baseline classifier
# team = Bundle/classifier.py with Team A rules + LLM fallback
SDOC_CLASSIFIER=team

# Optional: Python executable used by the Node-Python bridge
# PYTHON=Bundle/.venv/Scripts/python.exe

# Optional pipeline settings
# PIPELINE_DATA=Bundle
# PIPELINE_STAGES=src/stages.js#stagesFor